# Initialise empty dataframe
master_df <- NULL
# Loop through files and append
for (file in files) {
df <- read.csv(file)
master_df <- rbind(master_df, df)
}
# Estimator names (same order for all metrics)
estimator_names <- c("iv_ccf", "iv_ik", "lambda_1_ccf",
"lambda_1_ik", "lambda_4_ccf", "lambda_4_ik")
# Define metrics and column patterns
metrics <- list(
median_bias = list(
prefix = "median_bias_",
use_abs = TRUE
),
mad = list(
prefix = "mad_",
use_abs = FALSE
),
rmse = list(
prefix = "rmse_",
use_abs = FALSE
)
)
# Initialise results matrix
results_matrix <- matrix(0, nrow = length(metrics),
ncol = length(estimator_names))
rownames(results_matrix) <- names(metrics)
colnames(results_matrix) <- estimator_names
# Loop through each metric
for (metric_name in names(metrics)) {
metric_info <- metrics[[metric_name]]
# Build column names for this metric
cols <- paste0(metric_info$prefix, estimator_names)
# For each row, find best estimator
best_estimator <- apply(master_df[, cols], 1, function(row) {
if (metric_info$use_abs) {
which.min(abs(row))
} else {
which.min(row)
}
})
# Count wins for each estimator
wins <- table(factor(best_estimator, levels = 1:6))
results_matrix[metric_name, ] <- as.vector(wins)
}
# Convert to dataframe
results_df <- as.data.frame(results_matrix)
# Print results
cat("\nBest performing estimator counts across", nrow(master_df),
"configurations:\n\n")
print(results_df)
# Save output
write.csv(results_df,
file.path(SIMULATION_CSV_OUTPUT_FOLDER_PATH, "estimator_summary.csv"),
row.names = FALSE)
